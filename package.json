{
  "name": "note-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:write": "node scripts/write-version.mjs",
    "verify": "npm run typecheck && npm run test && npm run deploy:dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wrangler": "^4.80.0"
  }
}
